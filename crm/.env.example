# Copy to crm/.env. Do not commit crm/.env.
# Leave CRM_API_TOKEN empty for the local desk. Set a private token before sharing the API.
CRM_API_TOKEN=

# Used only by Docker Compose. Pick a private password made of letters and numbers.
# The database port is not published; only the API container can reach Postgres.
POSTGRES_USER=crm
POSTGRES_PASSWORD=
POSTGRES_DB=crm
